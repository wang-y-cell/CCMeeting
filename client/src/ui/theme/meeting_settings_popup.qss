/* ============================================================
 * meeting_settings_popup.qss — 会议设置弹出面板
 *
 * 说明：该面板是 Qt::Popup 顶层窗口，拿不到 MeetingWidget 的样式表，
 * 因此单独加载自己的 qss（与项目其它窗口一致）。
 * 令牌取值见 style.qss 顶部注释。
 * ============================================================ */
/* ---------- 会议设置弹出面板（Qt::Popup，锚定在按钮下方）---------- */

QWidget#meetingSettingsPopup {
    background-color: @popup;
    border: 1px solid @overlay;
    border-radius: 12px;
}

QLabel#msTitle {
    color: @text;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#msSection {
    color: @textFaint;
    font-size: 11px;
    background: transparent;
    border: none;
}

QLabel#msValue {
    color: @text;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#msHint {
    color: @textDisabled;
    font-size: 11px;
    background: transparent;
    border: none;
}

QLabel#msRoleBadge {
    color: @textMuted;
    background-color: @surface2;
    border: 1px solid @border;
    border-radius: 9px;
    padding: 1px 8px;
    font-size: 11px;
}

QLabel#msRoleBadge[isHost="true"] {
    color: @primary;
    background-color: rgba(76, 141, 255, 0.14);
    border: 1px solid rgba(76, 141, 255, 0.28);
}

QFrame#msSep {
    background-color: @borderSoft;
    border: none;
}

QCheckBox#msSwitch {
    color: @text;
    font-size: 12px;
    spacing: 8px;
    padding: 2px 0;
    background: transparent;
}

QCheckBox#msSwitch:disabled {
    color: @textFaint;
}

QCheckBox#msSwitch::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid @borderStrong;
    background: @surface2;
}

QCheckBox#msSwitch::indicator:hover {
    border-color: @primary;
}

QCheckBox#msSwitch::indicator:checked {
    background: @primary;
    border-color: @primary;
}

QCheckBox#msSwitch::indicator:disabled {
    background: @inset;
    border-color: @border;
}

QPushButton#msAction {
    background-color: @surface2;
    border: 1px solid @border;
    border-radius: 8px;
    color: @text;
    font-size: 12px;
    min-height: 30px;
    padding: 0 12px;
    text-align: left;
}

QPushButton#msAction:hover {
    background-color: @raised;
    border-color: @borderStrong;
}

QPushButton#msAction:pressed {
    background-color: @surface;
}
/* ---------- 录制按钮与状态 ---------- */

QPushButton#msRecordBtn {
    background-color: @surface2;
    border: 1px solid @overlay;
    border-radius: 8px;
    color: @text;
    font-size: 12px;
    font-weight: 500;
    min-height: 30px;
    padding: 0 16px;
}

QPushButton#msRecordBtn:hover {
    background-color: @raised;
    border-color: @hover;
}

QPushButton#msRecordBtn[recording="true"] {
    background-color: rgba(229, 72, 77, 0.16);
    border: 1px solid rgba(229, 72, 77, 0.38);
    color: @dangerHover;
}

QPushButton#msRecordBtn[recording="true"]:hover {
    background-color: rgba(229, 72, 77, 0.24);
    border-color: rgba(229, 72, 77, 0.52);
}

QPushButton#msRecordBtn:disabled {
    background-color: @inset;
    border-color: @borderSoft;
    color: @textDisabled;
}

QLabel#msRecordStatus {
    color: @textFaint;
    font-size: 11px;
    background: transparent;
    border: none;
}
