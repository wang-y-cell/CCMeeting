/* ============================================================
 * meeting_widget.qss — 会议窗口
 * 令牌取值见 style.qss 顶部注释
 *
 * 层级：画布 @canvasDeep < 窗口 @canvas < 顶栏/侧栏 @sidebar
 *       < 卡片 @surface < 悬浮工具条 @surface(带描边)
 * ============================================================ */

QWidget#meetingWidget {
    background-color: @canvas;
    border: 1px solid @border;
}

/* ---------- 顶部状态栏 ---------- */

QWidget#topStatusBar {
    background-color: @sidebar;
    border-bottom: 1px solid @borderSoft;
}

QLabel#topMainTitle {
    color: @text;
    font-size: 14px;
    font-weight: 600;
    padding-right: 6px;
    background: transparent;
    border: none;
}

QLabel#topRoomChip,
QLabel#topMemberChip {
    background-color: @surface;
    color: @textMuted;
    border: 1px solid @borderSoft;
    border-radius: 999px;
    padding: 3px 12px;
    font-size: 12px;
}

QLabel#topSpeakerLabel {
    color: @textFaint;
    font-size: 12px;
    background: transparent;
    border: none;
}

QLabel#topMeetStatus {
    background-color: @surface;
    color: @textMuted;
    border: 1px solid @borderSoft;
    border-radius: 999px;
    padding: 3px 12px;
    font-size: 12px;
}

QLabel#topMeetStatus[joined="true"] {
    background-color: rgba(61, 214, 140, 0.12);
    border: 1px solid rgba(61, 214, 140, 0.28);
    color: @success;
}

/* ---------- 主画面 ---------- */

QGroupBox#groupBox_2 {
    background-color: @videoBackdrop;
    border: 1px solid @borderSoft;
    border-radius: 12px;
    margin-top: 0;
    padding-top: 0;
}

QGroupBox#groupBox_2::title {
    height: 0;
    width: 0;
    color: transparent;
}

VideoGLWidget#mainshow_label {
    background-color: @videoBackdrop;
    border: none;
    border-radius: 12px;
}

/* 未入会时的画布占位提示 */
QLabel#canvasHint {
    color: @textDisabled;
    font-size: 13px;
    background: transparent;
    border: none;
}

/* ---------- 右侧面板 ---------- */

QTabWidget#tabWidget {
    background-color: @sidebar;
    border: 1px solid @borderSoft;
    border-radius: 12px;
}

QTabWidget::pane {
    background-color: @sidebar;
    border: none;
    border-top: 1px solid @borderSoft;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: @textFaint;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 14px;
    margin: 6px 3px;
    min-width: 44px;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: @raised;
    border: 1px solid @overlay;
    color: @text;
}

QTabBar::tab:hover:!selected {
    background-color: @surface;
    color: @textMuted;
}

/* ---------- 聊天 / 成员列表 ---------- */

QListWidget,
QListWidget#listWidget {
    background-color: @inset;
    border: none;
    border-radius: 8px;
    outline: none;
    color: @text;
    padding: 6px;
}

QListWidget::item,
QListWidget#listWidget::item {
    border: none;
    outline: none;
    background: transparent;
    padding: 0;
    margin: 0;
}

QListWidget::viewport,
QListWidget#listWidget::viewport {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget QScrollBar:vertical,
QListWidget#listWidget QScrollBar:vertical,
QScrollArea QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 6px;
}

QListWidget QScrollBar::handle:vertical {
    background: @overlay;
    border: none;
    border-radius: 3px;
    min-height: 24px;
}

QListWidget QScrollBar::handle:vertical:hover {
    background: @hover;
}

QListWidget QScrollBar::add-line:vertical,
QListWidget QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    border: none;
    background: transparent;
}

QListWidget QScrollBar::add-page:vertical,
QListWidget QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}

QAbstractScrollArea::corner {
    background: transparent;
    border: none;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ---------- 输入类 ---------- */

QPlainTextEdit,
QTextEdit,
QLineEdit {
    background-color: @surface;
    border: 1px solid @borderSoft;
    border-radius: 8px;
    color: @text;
    padding: 8px 10px;
    font-size: 13px;
    selection-background-color: @primary;
    selection-color: @onPrimary;
}

QPlainTextEdit:hover,
QTextEdit:hover,
QLineEdit:hover {
    border-color: @borderStrong;
}

QPlainTextEdit:focus,
QTextEdit:focus,
QLineEdit:focus {
    border: 1px solid @primary;
}

/* ---------- 分组框（会议信息页） ---------- */

QGroupBox {
    background-color: @surface;
    border: 1px solid @borderSoft;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px 10px 10px 10px;
    color: @textMuted;
    font-size: 12px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: @textFaint;
    background-color: transparent;
}

/* ---------- 底部工具条 ---------- */

QWidget#avToolbar {
    background-color: @canvas;
    border: none;
}

QWidget#controlPill {
    background-color: @popup;
    border: 1px solid @borderSoft;
    border-radius: 12px;
}

QFrame#pillSep1,
QFrame#pillSep2 {
    background-color: @border;
    border: none;
    max-width: 1px;
    margin: 10px 6px;
}

/* 侧栏切换 / 面板切换：次级按钮 */

QPushButton#btnSideMembers,
QPushButton#btnSideChat,
QPushButton#btnSideInfo,
QPushButton#btnTogglePanel {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: @textMuted;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 12px;
}

QPushButton#btnSideMembers:hover,
QPushButton#btnSideChat:hover,
QPushButton#btnSideInfo:hover,
QPushButton#btnTogglePanel:hover {
    background-color: @surface2;
    border-color: @border;
    color: @text;
}

QPushButton#btnTogglePanel:checked {
    background-color: rgba(76, 141, 255, 0.14);
    border-color: rgba(76, 141, 255, 0.24);
    color: @text;
}

/* 摄像头 / 麦克风 / 共享屏幕：开启=强调描边，关闭=中性 */

QPushButton#openAudio,
QPushButton#openVedio,
QPushButton#shareScreenBtn {
    border-radius: 8px;
    border: 1px solid @border;
    background-color: @surface;
    color: @textMuted;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 12px;
}

QPushButton#openAudio:hover,
QPushButton#openVedio:hover,
QPushButton#shareScreenBtn:hover {
    background-color: @surface2;
    border-color: @borderStrong;
    color: @text;
}

QPushButton#openAudio[avOn="true"],
QPushButton#openVedio[avOn="true"],
QPushButton#shareScreenBtn[avOn="true"] {
    background-color: rgba(76, 141, 255, 0.16);
    border: 1px solid rgba(76, 141, 255, 0.32);
    color: @text;
}

QPushButton#openAudio[avOn="true"]:hover,
QPushButton#openVedio[avOn="true"]:hover,
QPushButton#shareScreenBtn[avOn="true"]:hover {
    background-color: rgba(76, 141, 255, 0.24);
    border-color: rgba(76, 141, 255, 0.44);
    color: @onPrimary;
}

QPushButton#openAudio:disabled,
QPushButton#openVedio:disabled,
QPushButton#shareScreenBtn:disabled {
    background-color: @sidebar;
    border: 1px solid @borderSoft;
    color: @textDisabled;
}

/* 设备下拉箭头 */

QPushButton#audioDeviceBtn,
QPushButton#videoDeviceBtn {
    background-color: @surface;
    border: 1px solid @border;
    border-radius: 8px;
    color: @textFaint;
    font-size: 9px;
    padding: 0;
}

QPushButton#audioDeviceBtn:hover,
QPushButton#videoDeviceBtn:hover {
    background-color: @surface2;
    border-color: @borderStrong;
    color: @text;
}

QPushButton#audioDeviceBtn:disabled,
QPushButton#videoDeviceBtn:disabled {
    background-color: @sidebar;
    border-color: @borderSoft;
    color: @textDisabled;
}

/* 结束会议：语义色填充 */

QPushButton#leaveMeetingBtn {
    background-color: @danger;
    border: 1px solid @danger;
    border-radius: 8px;
    color: @onPrimary;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 16px;
}

QPushButton#leaveMeetingBtn:hover {
    background-color: @dangerHover;
    border-color: @dangerHover;
}

QPushButton#leaveMeetingBtn:pressed {
    background-color: @dangerPressed;
    border-color: @dangerPressed;
}

QPushButton#leaveMeetingBtn:disabled {
    background-color: @sidebar;
    border: 1px solid @borderSoft;
    color: @textDisabled;
}

/* ---------- 设备选择菜单 ---------- */

QMenu#deviceSelectMenu {
    background-color: @surface;
    border: 1px solid @borderStrong;
    border-radius: 10px;
    color: @text;
    padding: 6px;
    font-size: 12px;
}

QMenu#deviceSelectMenu::item {
    padding: 7px 26px 7px 12px;
    border-radius: 6px;
    margin: 1px 0;
}

QMenu#deviceSelectMenu::item:selected {
    background-color: rgba(76, 141, 255, 0.16);
    color: @onPrimary;
}

QMenu#deviceSelectMenu::item:disabled {
    color: @textFaint;
    background: transparent;
}

QMenu#deviceSelectMenu::separator {
    height: 1px;
    background: @border;
    margin: 6px 8px;
}

/* ---------- 发送按钮 ---------- */

QPushButton#sendmsg {
    background-color: @primary;
    border: 1px solid @primary;
    border-radius: 8px;
    color: @onPrimary;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#sendmsg:hover {
    background-color: @primaryHover;
    border-color: @primaryHover;
}

QPushButton#sendmsg:pressed {
    background-color: @primaryPressed;
    border-color: @primaryPressed;
}

QPushButton#sendmsg:disabled {
    background-color: @surface;
    border-color: @borderSoft;
    color: @textDisabled;
}

/* ---------- 通用文本 ---------- */

QLabel {
    color: @textMuted;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: @textFaint;
    font-size: 15px;
    font-weight: 500;
    padding: 0;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: @danger;
    color: @onPrimary;
}

QPushButton#framelessMaxBtn:hover {
    background-color: @raised;
    color: @text;
}
/* ---------- 顶栏「会议设置」按钮 ---------- */

QPushButton#btnMeetingSettings {
    background-color: @surface;
    border: 1px solid @borderSoft;
    border-radius: 999px;
    color: @textMuted;
    font-size: 12px;
    padding: 2px 12px;
}

QPushButton#btnMeetingSettings:hover {
    background-color: @surface2;
    border-color: @borderStrong;
    color: @text;
}

QPushButton#btnMeetingSettings:pressed {
    background-color: @popup;
    border-color: @primary;
}
/* ---------- 顶栏：会议时长 ---------- */

QLabel#topDurationChip {
    color: @textFaint;
    background-color: @inset;
    border: 1px solid @borderSoft;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 11px;
}

QLabel#topDurationChip[running="true"] {
    color: @success;
    background-color: rgba(61, 214, 140, 0.10);
    border: 1px solid rgba(61, 214, 140, 0.24);
}
