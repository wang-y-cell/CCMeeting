/* ============================================================
 * meeting_widget.qss — 会议窗口
 * 令牌取值见 style.qss 顶部注释
 *
 * 层级：画布 @canvasDeep < 窗口 @canvas < 顶栏/侧栏 @sidebar
 *       < 卡片 @surface < 悬浮工具条 @surface(带描边)
 * ============================================================ */

QWidget#meetingWidget {
    background-color: @canvas;
    border: 1px solid @border;
}

/* ---------- 顶部状态栏 ---------- */

QWidget#topStatusBar {
    background-color: @sidebar;
    border-bottom: 1px solid @borderSoft;
}

QLabel#topMainTitle {
    color: @text;
    font-size: 14px;
    font-weight: 600;
    padding-right: 6px;
    background: transparent;
    border: none;
}

QLabel#topRoomChip,
QLabel#topMemberChip {
    background: transparent;
    color: @textMuted;
    border: none;
    padding: 3px 8px;
    font-size: 12px;
}

QLabel#topSpeakerLabel {
    color: @textFaint;
    font-size: 12px;
    background: transparent;
    border: none;
}

QLabel#topMeetStatus {
    background: transparent;
    color: @textMuted;
    border: none;
    padding: 3px 8px;
    font-size: 12px;
}

/* 已入会状态不再用绿色强调，避免顶栏出现多余颜色 */
QLabel#topMeetStatus[joined="true"] {
    color: @text;
}

/* ---------- 主画面 ---------- */

QGroupBox#groupBox_2 {
    background-color: @videoBackdrop;
    border: 1px solid @borderSoft;
    border-radius: 12px;
    margin-top: 0;
    padding-top: 0;
}

QGroupBox#groupBox_2::title {
    height: 0;
    width: 0;
    color: transparent;
}

VideoGLWidget#mainshow_label {
    background-color: @videoBackdrop;
    border: none;
    border-radius: 12px;
}

/* 未入会时的画布占位提示 */
QLabel#canvasHint {
    color: @textDisabled;
    font-size: 13px;
    background: transparent;
    border: none;
}

/* ---------- 右侧面板 ---------- */

QTabWidget#tabWidget {
    background-color: @sidebar;
    border: 1px solid @borderSoft;
    border-radius: 12px;
}

QTabWidget::pane {
    background-color: @sidebar;
    border: none;
    border-top: 1px solid @borderSoft;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: @textFaint;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 14px;
    margin: 6px 3px;
    min-width: 44px;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: @raised;
    border: 1px solid @overlay;
    color: @text;
}

QTabBar::tab:hover:!selected {
    background-color: @surface;
    color: @textMuted;
}

/* ---------- 聊天 / 成员列表 ---------- */

QListWidget,
QListWidget#listWidget {
    background-color: @inset;
    border: none;
    border-radius: 8px;
    outline: none;
    color: @text;
    padding: 6px;
}

QListWidget::item,
QListWidget#listWidget::item {
    border: none;
    outline: none;
    background: transparent;
    padding: 0;
    margin: 0;
}

QListWidget::viewport,
QListWidget#listWidget::viewport {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget QScrollBar:vertical,
QListWidget#listWidget QScrollBar:vertical,
QScrollArea QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 6px;
}

QListWidget QScrollBar::handle:vertical {
    background: @overlay;
    border: none;
    border-radius: 3px;
    min-height: 24px;
}

QListWidget QScrollBar::handle:vertical:hover {
    background: @hover;
}

QListWidget QScrollBar::add-line:vertical,
QListWidget QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    border: none;
    background: transparent;
}

QListWidget QScrollBar::add-page:vertical,
QListWidget QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}

QAbstractScrollArea::corner {
    background: transparent;
    border: none;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ---------- 输入类 ---------- */

QPlainTextEdit,
QTextEdit,
QLineEdit {
    background-color: @surface;
    border: 1px solid @borderSoft;
    border-radius: 8px;
    color: @text;
    padding: 8px 10px;
    font-size: 13px;
    selection-background-color: @primary;
    selection-color: @onPrimary;
}

QPlainTextEdit:hover,
QTextEdit:hover,
QLineEdit:hover {
    border-color: @borderStrong;
}

QPlainTextEdit:focus,
QTextEdit:focus,
QLineEdit:focus {
    border: 1px solid @primary;
}

/* ---------- 分组框（会议信息页） ---------- */

QGroupBox {
    background-color: @surface;
    border: 1px solid @borderSoft;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px 10px 10px 10px;
    color: @textMuted;
    font-size: 12px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: @textFaint;
    background-color: transparent;
}

/* ---------- 底部工具条 ---------- */

QWidget#avToolbar {
    background-color: @canvas;
    border: none;
}

/* ---------- 底部工具条（图标在上、文字在下、无边框） ---------- */

QWidget#controlPill {
    background-color: transparent;
    border: none;
}

QFrame#pillSep1,
QFrame#pillSep2 {
    background-color: @borderSoft;
    border: none;
    max-width: 1px;
    margin: 14px 6px;
}

/* 所有工具按钮：默认无底色无边框，悬停才出现淡底 */
QToolButton#btnSideMembers,
QToolButton#btnSideChat,
QToolButton#btnSideInfo,
QToolButton#btnTogglePanel,
QToolButton#openAudio,
QToolButton#openVedio,
QToolButton#shareScreenBtn,
QToolButton#leaveMeetingBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: @textMuted;
    font-size: 11px;
    padding: 4px 8px;
}

QToolButton#btnSideMembers:hover,
QToolButton#btnSideChat:hover,
QToolButton#btnSideInfo:hover,
QToolButton#btnTogglePanel:hover,
QToolButton#openAudio:hover,
QToolButton#openVedio:hover,
QToolButton#shareScreenBtn:hover {
    background-color: @hover;
    color: @text;
}

QToolButton#btnTogglePanel:checked {
    background-color: @surface2;   /* 只用极淡底色表达"已开启"，不要强调色 */
    color: @text;
}

/* 设备下拉箭头：更小、更淡，同样无边框 */
QToolButton#audioDeviceBtn,
QToolButton#videoDeviceBtn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: @textFaint;
    padding: 0;
}

QToolButton#audioDeviceBtn:hover,
QToolButton#videoDeviceBtn:hover {
    background-color: @hover;
    color: @text;
}

/* 禁用：整体变淡，不额外上色 */
QToolButton#btnSideMembers:disabled,
QToolButton#btnSideChat:disabled,
QToolButton#btnSideInfo:disabled,
QToolButton#btnTogglePanel:disabled,
QToolButton#openAudio:disabled,
QToolButton#openVedio:disabled,
QToolButton#shareScreenBtn:disabled,
QToolButton#audioDeviceBtn:disabled,
QToolButton#videoDeviceBtn:disabled,
QToolButton#leaveMeetingBtn:disabled {
    color: @textDisabled;
    background-color: transparent;
}

/* 结束会议：唯一保留语义色的按钮（红字 + 红图标，无底色） */
QToolButton#leaveMeetingBtn {
    color: @danger;
}

QToolButton#leaveMeetingBtn:hover {
    background-color: rgba(229, 72, 77, 0.14);
    color: @danger;
}

QToolButton#leaveMeetingBtn:pressed {
    background-color: rgba(229, 72, 77, 0.22);
}
/* ---------- 设备选择菜单 ---------- */

QMenu#deviceSelectMenu {
    background-color: @surface;
    border: 1px solid @borderStrong;
    border-radius: 10px;
    color: @text;
    padding: 6px;
    font-size: 12px;
}

QMenu#deviceSelectMenu::item {
    padding: 7px 26px 7px 12px;
    border-radius: 6px;
    margin: 1px 0;
}

QMenu#deviceSelectMenu::item:selected {
    background-color: rgba(76, 141, 255, 0.16);
    color: @onPrimary;
}

QMenu#deviceSelectMenu::item:disabled {
    color: @textFaint;
    background: transparent;
}

QMenu#deviceSelectMenu::separator {
    height: 1px;
    background: @border;
    margin: 6px 8px;
}

/* ---------- 发送按钮 ---------- */

QPushButton#sendmsg {
    background-color: @primary;
    border: 1px solid @primary;
    border-radius: 8px;
    color: @onPrimary;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#sendmsg:hover {
    background-color: @primaryHover;
    border-color: @primaryHover;
}

QPushButton#sendmsg:pressed {
    background-color: @primaryPressed;
    border-color: @primaryPressed;
}

QPushButton#sendmsg:disabled {
    background-color: @surface;
    border-color: @borderSoft;
    color: @textDisabled;
}

/* ---------- 通用文本 ---------- */

QLabel {
    color: @textMuted;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: @textFaint;
    font-size: 15px;
    font-weight: 500;
    padding: 0;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: @danger;
    color: @onPrimary;
}

QPushButton#framelessMaxBtn:hover {
    background-color: @raised;
    color: @text;
}
/* ---------- 顶栏「会议设置」按钮 ---------- */

QPushButton#btnMeetingSettings {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: @textMuted;
    font-size: 12px;
    padding: 2px 8px;
}

QPushButton#btnMeetingSettings:hover {
    background-color: @hover;
    color: @text;
}

QPushButton#btnMeetingSettings:pressed {
    background-color: @surface2;
}
/* ---------- 顶栏：会议时长 ---------- */

QLabel#topDurationChip {
    color: @textFaint;
    background-color: @inset;
    border: 1px solid @borderSoft;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 11px;
}

QLabel#topDurationChip[running="true"] {
    color: @success;
    background-color: rgba(61, 214, 140, 0.10);
    border: 1px solid rgba(61, 214, 140, 0.24);
}
