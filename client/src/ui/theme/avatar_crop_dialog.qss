/* ============================================================
 * avatar_crop_dialog.qss — 头像裁剪对话框
 * 令牌取值见 style.qss 顶部注释
 * ============================================================ */

QDialog#avatarCropDialog {
    background-color: #0B0D11;
    border: 1px solid #232A35;
}

QLabel#cropHint {
    color: #98A2B3;
    font-size: 12px;
    padding: 2px 0 4px 0;
    background: transparent;
    border: none;
}

QWidget#avatarCropCanvas {
    background-color: #07080B;
    border: 1px solid #1E2530;
    border-radius: 12px;
}

/* 缩放 / 旋转工具按钮 */

QPushButton#cropToolBtn {
    background-color: #1B2029;
    color: #E9EDF4;
    border: 1px solid #232A35;
    border-radius: 8px;
    min-height: 36px;
    min-width: 36px;
    font-size: 16px;
    font-weight: 500;
    padding: 0;
}

QPushButton#cropToolBtn:hover {
    background-color: #1E242E;
    border-color: #2E3846;
}

QPushButton#cropToolBtn:pressed {
    background-color: #161A21;
    border-color: #4C8DFF;
}

QPushButton#cropResetBtn {
    background-color: transparent;
    color: #98A2B3;
    border: 1px solid #2A3341;
    border-radius: 8px;
    min-height: 36px;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#cropResetBtn:hover {
    background-color: #1E242E;
    border-color: #3A4557;
    color: #E9EDF4;
}

QPushButton#cropCancelBtn {
    background-color: transparent;
    color: #98A2B3;
    border: 1px solid #2A3341;
    border-radius: 8px;
    min-height: 36px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#cropCancelBtn:hover {
    background-color: #1E242E;
    border-color: #3A4557;
    color: #E9EDF4;
}

QPushButton#cropOkBtn {
    background-color: #4C8DFF;
    color: #FFFFFF;
    border: 1px solid #4C8DFF;
    border-radius: 8px;
    min-height: 36px;
    padding: 0 22px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#cropOkBtn:hover {
    background-color: #5E9BFF;
    border-color: #5E9BFF;
}

QPushButton#cropOkBtn:pressed {
    background-color: #3B7AE8;
    border-color: #3B7AE8;
}

QPushButton#cropOkBtn:disabled {
    background-color: #1B2029;
    border-color: #232A35;
    color: #6A7383;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: #6A7383;
    font-size: 15px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: #E5484D;
    color: #FFFFFF;
}

QPushButton#framelessMaxBtn:hover {
    background-color: #212836;
    color: #E9EDF4;
}
