/* ============================================================
 * avatar_crop_dialog.qss — 头像裁剪对话框
 * 令牌取值见 style.qss 顶部注释
 * ============================================================ */

QDialog#avatarCropDialog {
    background-color: @canvas;
    border: 1px solid @border;
}

QLabel#cropHint {
    color: @textMuted;
    font-size: 12px;
    padding: 2px 0 4px 0;
    background: transparent;
    border: none;
}

QWidget#avatarCropCanvas {
    background-color: @canvasDeep;
    border: 1px solid @borderSoft;
    border-radius: 12px;
}

/* 缩放 / 旋转工具按钮 */

QPushButton#cropToolBtn {
    background-color: @surface2;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    min-height: 36px;
    min-width: 36px;
    font-size: 16px;
    font-weight: 500;
    padding: 0;
}

QPushButton#cropToolBtn:hover {
    background-color: @surface3;
    border-color: @borderStrong;
}

QPushButton#cropToolBtn:pressed {
    background-color: @surface;
    border-color: @primary;
}

QPushButton#cropResetBtn {
    background-color: transparent;
    color: @textMuted;
    border: 1px solid @overlay;
    border-radius: 8px;
    min-height: 36px;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#cropResetBtn:hover {
    background-color: @surface3;
    border-color: @hover;
    color: @text;
}

QPushButton#cropCancelBtn {
    background-color: transparent;
    color: @textMuted;
    border: 1px solid @overlay;
    border-radius: 8px;
    min-height: 36px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#cropCancelBtn:hover {
    background-color: @surface3;
    border-color: @hover;
    color: @text;
}

QPushButton#cropOkBtn {
    background-color: @primary;
    color: @onPrimary;
    border: 1px solid @primary;
    border-radius: 8px;
    min-height: 36px;
    padding: 0 22px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#cropOkBtn:hover {
    background-color: @primaryHover;
    border-color: @primaryHover;
}

QPushButton#cropOkBtn:pressed {
    background-color: @primaryPressed;
    border-color: @primaryPressed;
}

QPushButton#cropOkBtn:disabled {
    background-color: @surface2;
    border-color: @border;
    color: @textFaint;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: @textFaint;
    font-size: 15px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: @danger;
    color: @onPrimary;
}

QPushButton#framelessMaxBtn:hover {
    background-color: @raised;
    color: @text;
}
