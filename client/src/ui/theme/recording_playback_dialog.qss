/* ============================================================
 * recording_playback_dialog.qss — 录制回放窗口
 * 令牌取值见 style.qss 顶部注释
 * ============================================================ */

QDialog#recordingPlayback {
    background-color: @canvas;
    border: 1px solid @border;
}

QLabel#playbackTitle {
    color: @text;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#playbackMeta {
    color: @textFaint;
    font-size: 12px;
    background: transparent;
    border: none;
}

VideoGLWidget#playbackVideo {
    background-color: @canvasDeep;
    border: 1px solid @borderSoft;
    border-radius: 12px;
}

QPushButton#playbackPlayBtn {
    background-color: @primary;
    border: 1px solid @primary;
    border-radius: 8px;
    color: @onPrimary;
    font-size: 12px;
    font-weight: 600;
    min-height: 32px;
    padding: 0 20px;
}

QPushButton#playbackPlayBtn:hover {
    background-color: @primaryHover;
    border-color: @primaryHover;
}

QLabel#playbackTime {
    color: @textMuted;
    font-size: 12px;
    min-width: 96px;
    background: transparent;
    border: none;
}

QSlider#playbackSlider::groove:horizontal {
    height: 4px;
    background: @border;
    border-radius: 2px;
}

QSlider#playbackSlider::sub-page:horizontal {
    background: @primary;
    border-radius: 2px;
}

QSlider#playbackSlider::handle:horizontal {
    background: @text;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider#playbackSlider::handle:horizontal:hover {
    background: @onPrimary;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: @textFaint;
    font-size: 15px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: @danger;
    color: @onPrimary;
}

QPushButton#framelessMaxBtn:hover {
    background-color: @raised;
    color: @text;
}
