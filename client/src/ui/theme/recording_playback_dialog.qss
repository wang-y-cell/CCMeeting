/* ============================================================
 * recording_playback_dialog.qss — 录制回放窗口
 * 令牌取值见 style.qss 顶部注释
 * ============================================================ */

QDialog#recordingPlayback {
    background-color: #0B0D11;
    border: 1px solid #232A35;
}

QLabel#playbackTitle {
    color: #E9EDF4;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#playbackMeta {
    color: #6A7383;
    font-size: 12px;
    background: transparent;
    border: none;
}

VideoGLWidget#playbackVideo {
    background-color: #07080B;
    border: 1px solid #1C2230;
    border-radius: 12px;
}

QPushButton#playbackPlayBtn {
    background-color: #4C8DFF;
    border: 1px solid #4C8DFF;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    min-height: 32px;
    padding: 0 20px;
}

QPushButton#playbackPlayBtn:hover {
    background-color: #5E9BFF;
    border-color: #5E9BFF;
}

QLabel#playbackTime {
    color: #98A2B3;
    font-size: 12px;
    min-width: 96px;
    background: transparent;
    border: none;
}

QSlider#playbackSlider::groove:horizontal {
    height: 4px;
    background: #232A35;
    border-radius: 2px;
}

QSlider#playbackSlider::sub-page:horizontal {
    background: #4C8DFF;
    border-radius: 2px;
}

QSlider#playbackSlider::handle:horizontal {
    background: #E9EDF4;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider#playbackSlider::handle:horizontal:hover {
    background: #FFFFFF;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: #6A7383;
    font-size: 15px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: #E5484D;
    color: #FFFFFF;
}

QPushButton#framelessMaxBtn:hover {
    background-color: #212836;
    color: #E9EDF4;
}
