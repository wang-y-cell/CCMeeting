/* ============================================================
 * style.qss — 全局基础样式（跨窗口共用）
 *
 * 设计令牌（QSS 无变量，集中记录于此，各窗口文件沿用同名取值）
 *
 * 表面（由深到浅，用于表现层级）
 *   canvas      @canvas   窗口底色
 *   sidebar     @sidebar   侧边栏
 *   surface     @surface   卡片
 *   surface2    @surface2   输入框 / 次级表面
 *   raised      @raised   选中项 / 悬浮工具条
 *
 * 描边
 *   border      @border   常规 1px 分隔
 *   borderStr   @borderStrong   强调描边（hover）
 *
 * 文字
 *   text        @text   主文字
 *   text2       @textMuted   次要文字（描述、标签）
 *   text3       @textFaint   弱化文字（占位、禁用）
 *
 * 强调与语义
 *   accent      @primary   hover @primaryHover   pressed @primaryPressed
 *   accentSoft  rgba(76, 141, 255, 0.16)
 *   danger      @danger   hover @dangerHover
 *   success     @success
 *   warning     @warning
 *
 * 圆角：控件 8px / 卡片 12px / 大卡片 14px / 胶囊 999px
 * 控件高度：输入 40px / 主按钮 42px / 次按钮 36px / 小按钮 28px
 * ============================================================ */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei";
    outline: none;
}

QToolTip {
    background-color: @raised;
    color: @text;
    border: 1px solid @borderStrong;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

QMessageBox {
    background-color: @surface;
}

QMessageBox QLabel {
    color: @text;
    font-size: 13px;
}

QMessageBox QPushButton {
    min-width: 76px;
    min-height: 32px;
    border: 1px solid @borderStrong;
    border-radius: 8px;
    background-color: @surface2;
    color: @text;
    font-size: 13px;
    padding: 0 14px;
}

QMessageBox QPushButton:hover {
    background-color: @raised;
    border-color: @hover;
}

QMessageBox QPushButton:pressed {
    background-color: @surfaceDeep;
}
