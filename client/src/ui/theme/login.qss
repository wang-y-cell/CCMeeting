/* ============================================================
 * login.qss — 登录 / 注册窗口
 * 令牌取值见 style.qss 顶部注释
 * ============================================================ */

QDialog#login {
    background-color: @canvas;
    border: 1px solid @border;
}

/* ---------- 品牌区 ---------- */

QLabel#logoLabel {
    background-color: rgba(76, 141, 255, 0.16);
    color: @primary;
    border: 1px solid rgba(76, 141, 255, 0.28);
    border-radius: 16px;
    font-size: 22px;
    font-weight: 700;
}

QLabel#brandLabel,
QLabel#registerBrandLabel {
    color: @text;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.5px;
    background: transparent;
    border: none;
}

QLabel#subtitleLabel,
QLabel#registerSubtitleLabel {
    color: @textMuted;
    font-size: 13px;
    background: transparent;
    border: none;
}

QLabel#hintLabel {
    color: @textFaint;
    font-size: 12px;
    background: transparent;
    border: none;
}

/* ---------- 文本链接 ---------- */

QLabel#createUserLink,
QLabel#backToLoginLink {
    color: @textFaint;
    font-size: 12px;
    background: transparent;
    border: none;
}

QLabel#createUserLink a,
QLabel#backToLoginLink a {
    color: @textMuted;
    text-decoration: none;
}

QLabel#createUserLink a:hover,
QLabel#backToLoginLink a:hover {
    color: @primaryHover;
    text-decoration: none;
}

/* ---------- 输入框 ---------- */

QLineEdit {
    background-color: @surface2;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 0 14px;
    font-size: 14px;
    selection-background-color: @primary;
    selection-color: @onPrimary;
}

QLineEdit:hover {
    border-color: @borderStrong;
    background-color: @surface3;
}

QLineEdit:focus {
    border: 1px solid @primary;
    background-color: @surface3;
}

/* ---------- 主按钮 ---------- */

QPushButton#login_button,
QPushButton#register_button {
    background-color: @primary;
    color: @onPrimary;
    border: 1px solid @primary;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    padding: 0 16px;
}

QPushButton#login_button:hover,
QPushButton#register_button:hover {
    background-color: @primaryHover;
    border-color: @primaryHover;
}

QPushButton#login_button:pressed,
QPushButton#register_button:pressed {
    background-color: @primaryPressed;
    border-color: @primaryPressed;
}

QPushButton#login_button:disabled,
QPushButton#register_button:disabled {
    background-color: @surface2;
    border-color: @border;
    color: @textFaint;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: @textFaint;
    font-size: 15px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: @danger;
    color: @onPrimary;
}

QPushButton#framelessMaxBtn:hover {
    background-color: @raised;
    color: @text;
}
