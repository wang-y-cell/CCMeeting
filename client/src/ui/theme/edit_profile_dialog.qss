/* ============================================================
 * edit_profile_dialog.qss — 修改资料对话框
 * 令牌取值见 style.qss 顶部注释
 * ============================================================ */

QDialog#editProfileDialog {
    background-color: @canvas;
    border: 1px solid @border;
}

QLabel#pageTitle {
    color: @text;
    font-size: 18px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#profileAvatarLarge {
    background-color: rgba(76, 141, 255, 0.16);
    border: 1px solid rgba(76, 141, 255, 0.24);
    border-radius: 64px;
    color: @primary;
    font-size: 34px;
    font-weight: 600;
}

QLabel#fieldLabelNickname,
QLabel#fieldLabelUsername,
QLabel#fieldLabelUserId,
QLabel#fieldLabelGender,
QLabel#fieldLabelAge,
QLabel#fieldLabelBirthday,
QLabel#fieldLabelAddress,
QLabel#fieldLabelPhone,
QLabel#fieldLabelEmail,
QLabel#fieldLabelInfo {
    color: @textMuted;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#valueUsername,
QLabel#valueUserId,
QLabel#valueGender,
QLabel#valueAge,
QLabel#valueBirthday,
QLabel#valueAddress,
QLabel#valuePhone,
QLabel#valueEmail,
QLabel#valueNickname,
QLabel#valueInfo,
QLabel#ageValue {
    color: @text;
    font-size: 13px;
    background: transparent;
    border: none;
}

/* ---------- 输入控件 ---------- */

QLineEdit#nicknameEdit,
QLineEdit#addressEdit,
QLineEdit#phoneEdit,
QLineEdit#emailEdit,
QDateEdit#birthdayEdit {
    background-color: @surface2;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 0 12px;
    min-height: 38px;
    font-size: 13px;
    selection-background-color: @primary;
    selection-color: @onPrimary;
}

QLineEdit#emailEdit:hover,
QDateEdit#birthdayEdit:hover {
    border-color: @borderStrong;
    background-color: @surface3;
}

QLineEdit#emailEdit:focus,
QDateEdit#birthdayEdit:focus {
    border: 1px solid @primary;
    background-color: @surface3;
}

QDateEdit#birthdayEdit::drop-down,
QComboBox#genderCombo::drop-down {
    border: none;
    width: 22px;
}

QComboBox#genderCombo {
    background-color: @surface2;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 0 12px;
    min-height: 38px;
    font-size: 13px;
}

QComboBox#genderCombo:hover {
    border-color: @borderStrong;
    background-color: @surface3;
}

QComboBox#genderCombo QAbstractItemView {
    background-color: @surface;
    border: 1px solid @borderStrong;
    border-radius: 8px;
    padding: 4px;
    color: @text;
    selection-background-color: rgba(76, 141, 255, 0.16);
    selection-color: @text;
    outline: none;
}

QTextEdit#infoEdit {
    background-color: @surface2;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
    selection-background-color: @primary;
    selection-color: @onPrimary;
}

QTextEdit#infoEdit:hover {
    border-color: @borderStrong;
}

QTextEdit#infoEdit:focus {
    border: 1px solid @primary;
}

QScrollArea#editProfileScroll {
    background: transparent;
    border: none;
}

QWidget#editProfileScrollContent {
    background: transparent;
}

/* ---------- 按钮 ---------- */

QPushButton#changeAvatarBtn {
    background-color: @surface3;
    color: @text;
    border: 1px solid @overlay;
    border-radius: 8px;
    min-height: 32px;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#changeAvatarBtn:hover {
    background-color: @raisedAlt;
    border-color: @hover;
}

QPushButton#editSaveBtn {
    background-color: @primary;
    color: @onPrimary;
    border: 1px solid @primary;
    border-radius: 8px;
    min-height: 38px;
    padding: 0 22px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#editSaveBtn:hover {
    background-color: @primaryHover;
    border-color: @primaryHover;
}

QPushButton#editSaveBtn:pressed {
    background-color: @primaryPressed;
    border-color: @primaryPressed;
}

QPushButton#editSaveBtn:disabled {
    background-color: @surface2;
    border-color: @border;
    color: @textFaint;
}

QPushButton#editCancelBtn {
    background-color: transparent;
    color: @textMuted;
    border: 1px solid @overlay;
    border-radius: 8px;
    min-height: 38px;
    padding: 0 22px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#editCancelBtn:hover {
    background-color: @surface3;
    border-color: @hover;
    color: @text;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: @textFaint;
    font-size: 15px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: @danger;
    color: @onPrimary;
}

QPushButton#framelessMaxBtn:hover {
    background-color: @raised;
    color: @text;
}
