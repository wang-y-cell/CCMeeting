/* ============================================================
 * main_window.qss — 主窗口（创建 / 加入 / 设置 / 个人资料）
 * 令牌取值见 style.qss 顶部注释
 * ============================================================ */

QWidget#main_window {
    background-color: #0B0D11;
    border: 1px solid #232A35;
}

/* ---------- 左侧导航栏 ---------- */

QWidget#sideBar {
    background-color: #101319;
    border: 1px solid #1C2230;
    border-radius: 12px;
}

QWidget#userProfile {
    background-color: #161A21;
    border: 1px solid #1E2530;
    border-radius: 10px;
}

QWidget#userProfile:hover {
    background-color: #1B2029;
    border-color: #2E3846;
}

QLabel#userAvatar {
    background-color: rgba(76, 141, 255, 0.16);
    border: 1px solid rgba(76, 141, 255, 0.24);
    border-radius: 36px;
    color: #4C8DFF;
    font-size: 22px;
    font-weight: 600;
}

QLabel#userName {
    color: #E9EDF4;
    font-size: 13px;
    font-weight: 600;
}

QListWidget#sideNav {
    background: transparent;
    border: none;
    padding: 0;
    outline: none;
}

QListWidget#sideNav::item {
    color: #98A2B3;
    border: 1px solid transparent;
    border-radius: 8px;
    margin: 2px 0;
    padding: 0 12px;
}

QListWidget#sideNav::item:hover {
    background-color: #161A21;
    color: #E9EDF4;
}

QListWidget#sideNav::item:selected {
    background-color: rgba(76, 141, 255, 0.14);
    border: 1px solid rgba(76, 141, 255, 0.24);
    color: #E9EDF4;
}

/* 侧边栏底部：连接状态 + 版本 */

QLabel#sideBarStatus {
    color: #98A2B3;
    font-size: 12px;
    background: transparent;
    border: none;
}

QLabel#sideBarVersion {
    color: #4E5666;
    font-size: 11px;
    background: transparent;
    border: none;
}

/* ---------- 内容区 ---------- */

QStackedWidget#contentStack,
QStackedWidget#settingPageStack {
    background: transparent;
    border: none;
}

QFrame#frame,
QFrame#profileFrame {
    background-color: #161A21;
    border: 1px solid #1E2530;
    border-radius: 12px;
}

QLabel {
    background: transparent;
    border: none;
    color: #E9EDF4;
}

QLabel#pageTitle {
    color: #E9EDF4;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

QLabel#pageDesc {
    color: #98A2B3;
    font-size: 13px;
}

QLabel#fieldLabel,
QLabel#fieldLabel_2,
QLabel#fieldLabelNickname,
QLabel#fieldLabelUsername,
QLabel#fieldLabelUserId,
QLabel#fieldLabelGender,
QLabel#fieldLabelAge,
QLabel#fieldLabelBirthday,
QLabel#fieldLabelAddress,
QLabel#fieldLabelPhone,
QLabel#fieldLabelEmail,
QLabel#fieldLabelInfo {
    color: #98A2B3;
    font-size: 12px;
    font-weight: 500;
}

QLabel#valueNickname,
QLabel#valueUsername,
QLabel#valueUserId,
QLabel#valueGender,
QLabel#valueAge,
QLabel#valueBirthday,
QLabel#valueAddress,
QLabel#valuePhone,
QLabel#valueEmail,
QLabel#valueInfo {
    color: #E9EDF4;
    font-size: 13px;
}

/* ---------- 输入控件 ---------- */

QLineEdit {
    background-color: #1B2029;
    color: #E9EDF4;
    border: 1px solid #232A35;
    border-radius: 8px;
    padding: 0 12px;
    min-height: 38px;
    font-size: 13px;
    selection-background-color: #4C8DFF;
    selection-color: #FFFFFF;
}

QLineEdit:hover {
    border-color: #2E3846;
    background-color: #1E242E;
}

QLineEdit:focus {
    border: 1px solid #4C8DFF;
    background-color: #1E242E;
}

QComboBox,
QSpinBox {
    background-color: #1B2029;
    color: #E9EDF4;
    border: 1px solid #232A35;
    border-radius: 8px;
    padding: 4px 10px;
    min-height: 30px;
    font-size: 13px;
}

QComboBox:hover,
QSpinBox:hover {
    border-color: #2E3846;
    background-color: #1E242E;
}

QComboBox {
    max-width: 420px;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #161A21;
    border: 1px solid #2E3846;
    border-radius: 8px;
    padding: 4px;
    color: #E9EDF4;
    selection-background-color: rgba(76, 141, 255, 0.16);
    selection-color: #E9EDF4;
    outline: none;
}

QCheckBox {
    color: #E9EDF4;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #2E3846;
    background: #1B2029;
}

QCheckBox::indicator:hover {
    border-color: #3A4557;
}

QCheckBox::indicator:checked {
    background: #4C8DFF;
    border-color: #4C8DFF;
}

/* ---------- 按钮：默认次级，主操作走 id 覆盖 ---------- */

QPushButton {
    background-color: #1E242E;
    color: #E9EDF4;
    border: 1px solid #2A3341;
    border-radius: 8px;
    min-height: 34px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #252D3A;
    border-color: #3A4557;
}

QPushButton:pressed {
    background-color: #1A2029;
}

QPushButton:disabled {
    background-color: #14181F;
    border-color: #1E2530;
    color: #6A7383;
}

QPushButton#create_meeting_btn,
QPushButton#joinMeeting_btn,
QPushButton#connServer_btn,
QPushButton#settingsSaveBtn,
QPushButton#editProfileBtn {
    background-color: #4C8DFF;
    color: #FFFFFF;
    border: 1px solid #4C8DFF;
    min-height: 40px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#create_meeting_btn:hover,
QPushButton#joinMeeting_btn:hover,
QPushButton#connServer_btn:hover,
QPushButton#settingsSaveBtn:hover,
QPushButton#editProfileBtn:hover {
    background-color: #5E9BFF;
    border-color: #5E9BFF;
}

QPushButton#create_meeting_btn:pressed,
QPushButton#joinMeeting_btn:pressed,
QPushButton#connServer_btn:pressed,
QPushButton#settingsSaveBtn:pressed,
QPushButton#editProfileBtn:pressed {
    background-color: #3B7AE8;
    border-color: #3B7AE8;
}

QPushButton#create_meeting_btn:disabled,
QPushButton#joinMeeting_btn:disabled,
QPushButton#connServer_btn:disabled,
QPushButton#settingsSaveBtn:disabled,
QPushButton#editProfileBtn:disabled {
    background-color: #1B2029;
    border-color: #232A35;
    color: #6A7383;
}

QPushButton#changeAvatarBtn {
    min-height: 32px;
    font-size: 12px;
}

QPushButton#backHomeBtn {
    max-width: 160px;
}

QPushButton#backHomeBtn,
QPushButton#settingsResetBtn {
    background-color: transparent;
    border: 1px solid #2A3341;
    color: #98A2B3;
    min-height: 34px;
    font-size: 13px;
}

QPushButton#backHomeBtn:hover,
QPushButton#settingsResetBtn:hover {
    background-color: #1E242E;
    border-color: #3A4557;
    color: #E9EDF4;
}

/* ---------- 滚动容器 ---------- */

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #2A3341;
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: #3A4557;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

/* ---------- 个人资料 ---------- */

QLabel#profileAvatarLarge {
    background-color: rgba(76, 141, 255, 0.16);
    border: 1px solid rgba(76, 141, 255, 0.24);
    border-radius: 64px;
    color: #4C8DFF;
    font-size: 36px;
    font-weight: 600;
}

/* ---------- 设置页 ---------- */

QListWidget#settingCategoryList {
    background-color: #101319;
    border: 1px solid #1C2230;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

QListWidget#settingCategoryList::item {
    color: #98A2B3;
    border: 1px solid transparent;
    border-radius: 8px;
    margin: 2px 0;
    padding: 0 10px;
}

QListWidget#settingCategoryList::item:hover {
    background-color: #161A21;
    color: #E9EDF4;
}

QListWidget#settingCategoryList::item:selected {
    background-color: rgba(76, 141, 255, 0.14);
    border: 1px solid rgba(76, 141, 255, 0.24);
    color: #E9EDF4;
}

QProgressBar#micLevelBar {
    background-color: #1B2029;
    border: 1px solid #232A35;
    border-radius: 5px;
    text-align: center;
    color: #98A2B3;
    font-size: 11px;
    max-height: 10px;
}

QProgressBar#micLevelBar::chunk {
    background-color: #3DD68C;
    border-radius: 4px;
}

QLabel#settingsVideoPreview {
    background-color: #0B0D11;
    border: 1px dashed #2A3341;
    border-radius: 10px;
    color: #4E5666;
    font-size: 12px;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: #6A7383;
    font-size: 15px;
    font-weight: 500;
    border-radius: 6px;
    min-height: 0;
    padding: 0;
}

QPushButton#framelessCloseBtn:hover {
    background-color: #E5484D;
    color: #FFFFFF;
}

QPushButton#framelessMaxBtn:hover {
    background-color: #212836;
    color: #E9EDF4;
}
/* ---------- 创建会议页的小贴士卡片 ---------- */

QFrame#tipCard {
    background-color: #101319;
    border: 1px solid #1C2230;
    border-radius: 12px;
}

QLabel#tipTitle {
    color: #E9EDF4;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#tipLine {
    color: #8B94A6;
    font-size: 12px;
    line-height: 18px;
    background: transparent;
    border: none;
}
/* ---------- 「最近 N 个会议」小块（创建 / 加入页下方）---------- */

QFrame#recentCard {
    background-color: #101319;
    border: 1px solid #1C2230;
    border-radius: 12px;
}

QLabel#recentTitle {
    color: #E9EDF4;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#recentEmpty {
    color: #4E5666;
    font-size: 12px;
    padding: 6px 0;
    background: transparent;
    border: none;
}

QFrame#recentRow {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

QFrame#recentRow:hover {
    background-color: #161A21;
    border-color: #232A35;
}

QLabel#recentRoom {
    color: #E9EDF4;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#recentMeta {
    color: #6A7383;
    font-size: 11px;
    background: transparent;
    border: none;
}

/* ---------- 会议记录页 ---------- */

QWidget#stack_meeting_history {
    background: transparent;
}

QScrollArea#historyScroll {
    background: transparent;
    border: none;
}

QWidget#historyScrollContent {
    background: transparent;
}

QLabel#historyEmpty {
    color: #4E5666;
    font-size: 13px;
    padding: 40px 0;
    background: transparent;
    border: 1px dashed #232A35;
    border-radius: 12px;
}

QFrame#historyRow {
    background-color: #161A21;
    border: 1px solid #1E2530;
    border-radius: 12px;
}

QFrame#historyRow:hover {
    background-color: #1B2029;
    border-color: #2E3846;
}

QLabel#historyBadge {
    color: #98A2B3;
    background-color: #1B2029;
    border: 1px solid #232A35;
    border-radius: 8px;
    padding: 2px 10px;
    font-size: 11px;
    min-width: 44px;
}

QLabel#historyBadge[kind="created"] {
    color: #4C8DFF;
    background-color: rgba(76, 141, 255, 0.14);
    border: 1px solid rgba(76, 141, 255, 0.28);
}

QLabel#historyBadge[kind="joined"] {
    color: #3DD68C;
    background-color: rgba(61, 214, 140, 0.12);
    border: 1px solid rgba(61, 214, 140, 0.26);
}

QLabel#historyRoom {
    color: #E9EDF4;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#historyMeta {
    color: #6A7383;
    font-size: 12px;
    background: transparent;
    border: none;
}

QPushButton#historyDeleteBtn {
    background-color: transparent;
    border: 1px solid #2A3341;
    border-radius: 8px;
    color: #98A2B3;
    font-size: 12px;
    min-height: 30px;
    padding: 0 14px;
}

QPushButton#historyDeleteBtn:hover {
    background-color: rgba(229, 72, 77, 0.14);
    border-color: rgba(229, 72, 77, 0.36);
    color: #F05C60;
}

QPushButton#historyGhostBtn {
    background-color: transparent;
    border: 1px solid #2A3341;
    border-radius: 8px;
    color: #98A2B3;
    font-size: 12px;
    min-height: 30px;
    padding: 0 14px;
}

QPushButton#historyGhostBtn:hover {
    background-color: #1E242E;
    border-color: #3A4557;
    color: #E9EDF4;
}

QPushButton#historyChip {
    background-color: transparent;
    border: 1px solid #2A3341;
    border-radius: 999px;
    color: #98A2B3;
    font-size: 12px;
    min-height: 28px;
    padding: 0 16px;
}

QPushButton#historyChip:hover {
    background-color: #1B2029;
    border-color: #3A4557;
    color: #E9EDF4;
}

QPushButton#historyChip:checked {
    background-color: rgba(76, 141, 255, 0.16);
    border: 1px solid rgba(76, 141, 255, 0.34);
    color: #E9EDF4;
}
/* ---------- 设置页：摄像头预览开关 ---------- */

QPushButton#videoPreviewToggleBtn {
    background-color: #1E242E;
    border: 1px solid #2A3341;
    border-radius: 8px;
    color: #E9EDF4;
    font-size: 12px;
    font-weight: 500;
    min-height: 32px;
    padding: 0 14px;
}

QPushButton#videoPreviewToggleBtn:hover {
    background-color: #252D3A;
    border-color: #3A4557;
}

QPushButton#videoPreviewToggleBtn[previewOn="true"] {
    background-color: rgba(76, 141, 255, 0.16);
    border: 1px solid rgba(76, 141, 255, 0.32);
    color: #E9EDF4;
}

QPushButton#videoPreviewToggleBtn[previewOn="true"]:hover {
    background-color: rgba(76, 141, 255, 0.24);
    border-color: rgba(76, 141, 255, 0.44);
}
/* ---------- 设置页：通用（录制目录）---------- */

QLabel#recordDirLabel {
    color: #98A2B3;
    background-color: #12161D;
    border: 1px solid #1E2530;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
}

QPushButton#recordDirBtn {
    background-color: #1E242E;
    border: 1px solid #2A3341;
    border-radius: 8px;
    color: #E9EDF4;
    font-size: 12px;
    font-weight: 500;
    min-height: 32px;
}

QPushButton#recordDirBtn:hover {
    background-color: #252D3A;
    border-color: #3A4557;
}
