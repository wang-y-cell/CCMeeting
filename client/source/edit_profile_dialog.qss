/* ============================================================
 * edit_profile_dialog.qss — 修改资料对话框
 * 令牌取值见 style.qss 顶部注释
 * ============================================================ */

QDialog#editProfileDialog {
    background-color: #0B0D11;
    border: 1px solid #232A35;
}

QLabel#pageTitle {
    color: #E9EDF4;
    font-size: 18px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#profileAvatarLarge {
    background-color: rgba(76, 141, 255, 0.16);
    border: 1px solid rgba(76, 141, 255, 0.24);
    border-radius: 64px;
    color: #4C8DFF;
    font-size: 34px;
    font-weight: 600;
}

QLabel#fieldLabelNickname,
QLabel#fieldLabelUsername,
QLabel#fieldLabelUserId,
QLabel#fieldLabelGender,
QLabel#fieldLabelAge,
QLabel#fieldLabelBirthday,
QLabel#fieldLabelAddress,
QLabel#fieldLabelPhone,
QLabel#fieldLabelEmail,
QLabel#fieldLabelInfo {
    color: #98A2B3;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#valueUsername,
QLabel#valueUserId,
QLabel#valueGender,
QLabel#valueAge,
QLabel#valueBirthday,
QLabel#valueAddress,
QLabel#valuePhone,
QLabel#valueEmail,
QLabel#valueNickname,
QLabel#valueInfo,
QLabel#ageValue {
    color: #E9EDF4;
    font-size: 13px;
    background: transparent;
    border: none;
}

/* ---------- 输入控件 ---------- */

QLineEdit#nicknameEdit,
QLineEdit#addressEdit,
QLineEdit#phoneEdit,
QLineEdit#emailEdit,
QDateEdit#birthdayEdit {
    background-color: #1B2029;
    color: #E9EDF4;
    border: 1px solid #232A35;
    border-radius: 8px;
    padding: 0 12px;
    min-height: 38px;
    font-size: 13px;
    selection-background-color: #4C8DFF;
    selection-color: #FFFFFF;
}

QLineEdit#emailEdit:hover,
QDateEdit#birthdayEdit:hover {
    border-color: #2E3846;
    background-color: #1E242E;
}

QLineEdit#emailEdit:focus,
QDateEdit#birthdayEdit:focus {
    border: 1px solid #4C8DFF;
    background-color: #1E242E;
}

QDateEdit#birthdayEdit::drop-down,
QComboBox#genderCombo::drop-down {
    border: none;
    width: 22px;
}

QComboBox#genderCombo {
    background-color: #1B2029;
    color: #E9EDF4;
    border: 1px solid #232A35;
    border-radius: 8px;
    padding: 0 12px;
    min-height: 38px;
    font-size: 13px;
}

QComboBox#genderCombo:hover {
    border-color: #2E3846;
    background-color: #1E242E;
}

QComboBox#genderCombo QAbstractItemView {
    background-color: #161A21;
    border: 1px solid #2E3846;
    border-radius: 8px;
    padding: 4px;
    color: #E9EDF4;
    selection-background-color: rgba(76, 141, 255, 0.16);
    selection-color: #E9EDF4;
    outline: none;
}

QTextEdit#infoEdit {
    background-color: #1B2029;
    color: #E9EDF4;
    border: 1px solid #232A35;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
    selection-background-color: #4C8DFF;
    selection-color: #FFFFFF;
}

QTextEdit#infoEdit:hover {
    border-color: #2E3846;
}

QTextEdit#infoEdit:focus {
    border: 1px solid #4C8DFF;
}

QScrollArea#editProfileScroll {
    background: transparent;
    border: none;
}

QWidget#editProfileScrollContent {
    background: transparent;
}

/* ---------- 按钮 ---------- */

QPushButton#changeAvatarBtn {
    background-color: #1E242E;
    color: #E9EDF4;
    border: 1px solid #2A3341;
    border-radius: 8px;
    min-height: 32px;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#changeAvatarBtn:hover {
    background-color: #252D3A;
    border-color: #3A4557;
}

QPushButton#editSaveBtn {
    background-color: #4C8DFF;
    color: #FFFFFF;
    border: 1px solid #4C8DFF;
    border-radius: 8px;
    min-height: 38px;
    padding: 0 22px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#editSaveBtn:hover {
    background-color: #5E9BFF;
    border-color: #5E9BFF;
}

QPushButton#editSaveBtn:pressed {
    background-color: #3B7AE8;
    border-color: #3B7AE8;
}

QPushButton#editSaveBtn:disabled {
    background-color: #1B2029;
    border-color: #232A35;
    color: #6A7383;
}

QPushButton#editCancelBtn {
    background-color: transparent;
    color: #98A2B3;
    border: 1px solid #2A3341;
    border-radius: 8px;
    min-height: 38px;
    padding: 0 22px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#editCancelBtn:hover {
    background-color: #1E242E;
    border-color: #3A4557;
    color: #E9EDF4;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: #6A7383;
    font-size: 15px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: #E5484D;
    color: #FFFFFF;
}

QPushButton#framelessMaxBtn:hover {
    background-color: #212836;
    color: #E9EDF4;
}
