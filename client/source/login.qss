/* ============================================================
 * login.qss — 登录 / 注册窗口
 * 令牌取值见 style.qss 顶部注释
 * ============================================================ */

QDialog#login {
    background-color: #0B0D11;
    border: 1px solid #232A35;
}

/* ---------- 品牌区 ---------- */

QLabel#logoLabel {
    background-color: rgba(76, 141, 255, 0.16);
    color: #4C8DFF;
    border: 1px solid rgba(76, 141, 255, 0.28);
    border-radius: 16px;
    font-size: 22px;
    font-weight: 700;
}

QLabel#brandLabel,
QLabel#registerBrandLabel {
    color: #E9EDF4;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.5px;
    background: transparent;
    border: none;
}

QLabel#subtitleLabel,
QLabel#registerSubtitleLabel {
    color: #98A2B3;
    font-size: 13px;
    background: transparent;
    border: none;
}

QLabel#hintLabel {
    color: #6A7383;
    font-size: 12px;
    background: transparent;
    border: none;
}

/* ---------- 文本链接 ---------- */

QLabel#createUserLink,
QLabel#backToLoginLink {
    color: #6A7383;
    font-size: 12px;
    background: transparent;
    border: none;
}

QLabel#createUserLink a,
QLabel#backToLoginLink a {
    color: #98A2B3;
    text-decoration: none;
}

QLabel#createUserLink a:hover,
QLabel#backToLoginLink a:hover {
    color: #5E9BFF;
    text-decoration: none;
}

/* ---------- 输入框 ---------- */

QLineEdit {
    background-color: #1B2029;
    color: #E9EDF4;
    border: 1px solid #232A35;
    border-radius: 8px;
    padding: 0 14px;
    font-size: 14px;
    selection-background-color: #4C8DFF;
    selection-color: #FFFFFF;
}

QLineEdit:hover {
    border-color: #2E3846;
    background-color: #1E242E;
}

QLineEdit:focus {
    border: 1px solid #4C8DFF;
    background-color: #1E242E;
}

/* ---------- 主按钮 ---------- */

QPushButton#login_button,
QPushButton#register_button {
    background-color: #4C8DFF;
    color: #FFFFFF;
    border: 1px solid #4C8DFF;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    padding: 0 16px;
}

QPushButton#login_button:hover,
QPushButton#register_button:hover {
    background-color: #5E9BFF;
    border-color: #5E9BFF;
}

QPushButton#login_button:pressed,
QPushButton#register_button:pressed {
    background-color: #3B7AE8;
    border-color: #3B7AE8;
}

QPushButton#login_button:disabled,
QPushButton#register_button:disabled {
    background-color: #1B2029;
    border-color: #232A35;
    color: #6A7383;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: #6A7383;
    font-size: 15px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: #E5484D;
    color: #FFFFFF;
}

QPushButton#framelessMaxBtn:hover {
    background-color: #212836;
    color: #E9EDF4;
}
