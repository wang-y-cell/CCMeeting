/* 全局仅保留跨窗口共用的基础项；各窗口样式见独立 *.qss */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei";
    outline: none;
}

QToolTip {
    background-color: #2a2f3c;
    color: #e8ebf2;
    border: 1px solid #3a4152;
    padding: 6px 8px;
    border-radius: 6px;
}

QMessageBox {
    background-color: #1e2129;
}

QMessageBox QLabel {
    color: #e8ebf2;
}
