/* ============================================================
 * meeting_widget.qss — 会议窗口
 * 令牌取值见 style.qss 顶部注释
 *
 * 层级：画布 #07080B < 窗口 #0B0D11 < 顶栏/侧栏 #101319
 *       < 卡片 #161A21 < 悬浮工具条 #161A21(带描边)
 * ============================================================ */

QWidget#meetingWidget {
    background-color: #0B0D11;
    border: 1px solid #232A35;
}

/* ---------- 顶部状态栏 ---------- */

QWidget#topStatusBar {
    background-color: #101319;
    border-bottom: 1px solid #1C2230;
}

QLabel#topMainTitle {
    color: #E9EDF4;
    font-size: 14px;
    font-weight: 600;
    padding-right: 6px;
    background: transparent;
    border: none;
}

QLabel#topRoomChip,
QLabel#topMemberChip {
    background-color: #161A21;
    color: #98A2B3;
    border: 1px solid #1E2530;
    border-radius: 999px;
    padding: 3px 12px;
    font-size: 12px;
}

QLabel#topSpeakerLabel {
    color: #6A7383;
    font-size: 12px;
    background: transparent;
    border: none;
}

QLabel#topMeetStatus {
    background-color: #161A21;
    color: #98A2B3;
    border: 1px solid #1E2530;
    border-radius: 999px;
    padding: 3px 12px;
    font-size: 12px;
}

QLabel#topMeetStatus[joined="true"] {
    background-color: rgba(61, 214, 140, 0.12);
    border: 1px solid rgba(61, 214, 140, 0.28);
    color: #3DD68C;
}

/* ---------- 主画面 ---------- */

QGroupBox#groupBox_2 {
    background-color: #07080B;
    border: 1px solid #1C2230;
    border-radius: 12px;
    margin-top: 0;
    padding-top: 0;
}

QGroupBox#groupBox_2::title {
    height: 0;
    width: 0;
    color: transparent;
}

VideoGLWidget#mainshow_label {
    background-color: #07080B;
    border: none;
    border-radius: 12px;
}

/* 未入会时的画布占位提示 */
QLabel#canvasHint {
    color: #4E5666;
    font-size: 13px;
    background: transparent;
    border: none;
}

/* ---------- 右侧面板 ---------- */

QTabWidget#tabWidget {
    background-color: #101319;
    border: 1px solid #1C2230;
    border-radius: 12px;
}

QTabWidget::pane {
    background-color: #101319;
    border: none;
    border-top: 1px solid #1C2230;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #6A7383;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 14px;
    margin: 6px 3px;
    min-width: 44px;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: #212836;
    border: 1px solid #2A3341;
    color: #E9EDF4;
}

QTabBar::tab:hover:!selected {
    background-color: #161A21;
    color: #98A2B3;
}

/* ---------- 聊天 / 成员列表 ---------- */

QListWidget,
QListWidget#listWidget {
    background-color: #0E1116;
    border: none;
    border-radius: 8px;
    outline: none;
    color: #E9EDF4;
    padding: 6px;
}

QListWidget::item,
QListWidget#listWidget::item {
    border: none;
    outline: none;
    background: transparent;
    padding: 0;
    margin: 0;
}

QListWidget::viewport,
QListWidget#listWidget::viewport {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget QScrollBar:vertical,
QListWidget#listWidget QScrollBar:vertical,
QScrollArea QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 6px;
}

QListWidget QScrollBar::handle:vertical {
    background: #2A3341;
    border: none;
    border-radius: 3px;
    min-height: 24px;
}

QListWidget QScrollBar::handle:vertical:hover {
    background: #3A4557;
}

QListWidget QScrollBar::add-line:vertical,
QListWidget QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    border: none;
    background: transparent;
}

QListWidget QScrollBar::add-page:vertical,
QListWidget QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}

QAbstractScrollArea::corner {
    background: transparent;
    border: none;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ---------- 输入类 ---------- */

QPlainTextEdit,
QTextEdit,
QLineEdit {
    background-color: #161A21;
    border: 1px solid #1E2530;
    border-radius: 8px;
    color: #E9EDF4;
    padding: 8px 10px;
    font-size: 13px;
    selection-background-color: #4C8DFF;
    selection-color: #FFFFFF;
}

QPlainTextEdit:hover,
QTextEdit:hover,
QLineEdit:hover {
    border-color: #2E3846;
}

QPlainTextEdit:focus,
QTextEdit:focus,
QLineEdit:focus {
    border: 1px solid #4C8DFF;
}

/* ---------- 分组框（会议信息页） ---------- */

QGroupBox {
    background-color: #161A21;
    border: 1px solid #1E2530;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px 10px 10px 10px;
    color: #98A2B3;
    font-size: 12px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #6A7383;
    background-color: transparent;
}

/* ---------- 底部工具条 ---------- */

QWidget#avToolbar {
    background-color: #0B0D11;
    border: none;
}

QWidget#controlPill {
    background-color: #12161D;
    border: 1px solid #1E2530;
    border-radius: 12px;
}

QFrame#pillSep1,
QFrame#pillSep2 {
    background-color: #232A35;
    border: none;
    max-width: 1px;
    margin: 10px 6px;
}

/* 侧栏切换 / 面板切换：次级按钮 */

QPushButton#btnSideMembers,
QPushButton#btnSideChat,
QPushButton#btnSideInfo,
QPushButton#btnTogglePanel {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #98A2B3;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 12px;
}

QPushButton#btnSideMembers:hover,
QPushButton#btnSideChat:hover,
QPushButton#btnSideInfo:hover,
QPushButton#btnTogglePanel:hover {
    background-color: #1B2029;
    border-color: #232A35;
    color: #E9EDF4;
}

QPushButton#btnTogglePanel:checked {
    background-color: rgba(76, 141, 255, 0.14);
    border-color: rgba(76, 141, 255, 0.24);
    color: #E9EDF4;
}

/* 摄像头 / 麦克风 / 共享屏幕：开启=强调描边，关闭=中性 */

QPushButton#openAudio,
QPushButton#openVedio,
QPushButton#shareScreenBtn {
    border-radius: 8px;
    border: 1px solid #232A35;
    background-color: #161A21;
    color: #98A2B3;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 12px;
}

QPushButton#openAudio:hover,
QPushButton#openVedio:hover,
QPushButton#shareScreenBtn:hover {
    background-color: #1B2029;
    border-color: #2E3846;
    color: #E9EDF4;
}

QPushButton#openAudio[avOn="true"],
QPushButton#openVedio[avOn="true"],
QPushButton#shareScreenBtn[avOn="true"] {
    background-color: rgba(76, 141, 255, 0.16);
    border: 1px solid rgba(76, 141, 255, 0.32);
    color: #E9EDF4;
}

QPushButton#openAudio[avOn="true"]:hover,
QPushButton#openVedio[avOn="true"]:hover,
QPushButton#shareScreenBtn[avOn="true"]:hover {
    background-color: rgba(76, 141, 255, 0.24);
    border-color: rgba(76, 141, 255, 0.44);
    color: #FFFFFF;
}

QPushButton#openAudio:disabled,
QPushButton#openVedio:disabled,
QPushButton#shareScreenBtn:disabled {
    background-color: #101319;
    border: 1px solid #1A2028;
    color: #4E5666;
}

/* 设备下拉箭头 */

QPushButton#audioDeviceBtn,
QPushButton#videoDeviceBtn {
    background-color: #161A21;
    border: 1px solid #232A35;
    border-radius: 8px;
    color: #6A7383;
    font-size: 9px;
    padding: 0;
}

QPushButton#audioDeviceBtn:hover,
QPushButton#videoDeviceBtn:hover {
    background-color: #1B2029;
    border-color: #2E3846;
    color: #E9EDF4;
}

QPushButton#audioDeviceBtn:disabled,
QPushButton#videoDeviceBtn:disabled {
    background-color: #101319;
    border-color: #1A2028;
    color: #3A414D;
}

/* 结束会议：语义色填充 */

QPushButton#leaveMeetingBtn {
    background-color: #E5484D;
    border: 1px solid #E5484D;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 16px;
}

QPushButton#leaveMeetingBtn:hover {
    background-color: #F05C60;
    border-color: #F05C60;
}

QPushButton#leaveMeetingBtn:pressed {
    background-color: #C93A3F;
    border-color: #C93A3F;
}

QPushButton#leaveMeetingBtn:disabled {
    background-color: #101319;
    border: 1px solid #1A2028;
    color: #4E5666;
}

/* ---------- 设备选择菜单 ---------- */

QMenu#deviceSelectMenu {
    background-color: #161A21;
    border: 1px solid #2E3846;
    border-radius: 10px;
    color: #E9EDF4;
    padding: 6px;
    font-size: 12px;
}

QMenu#deviceSelectMenu::item {
    padding: 7px 26px 7px 12px;
    border-radius: 6px;
    margin: 1px 0;
}

QMenu#deviceSelectMenu::item:selected {
    background-color: rgba(76, 141, 255, 0.16);
    color: #FFFFFF;
}

QMenu#deviceSelectMenu::item:disabled {
    color: #6A7383;
    background: transparent;
}

QMenu#deviceSelectMenu::separator {
    height: 1px;
    background: #232A35;
    margin: 6px 8px;
}

/* ---------- 发送按钮 ---------- */

QPushButton#sendmsg {
    background-color: #4C8DFF;
    border: 1px solid #4C8DFF;
    border-radius: 8px;
    color: #FFFFFF;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#sendmsg:hover {
    background-color: #5E9BFF;
    border-color: #5E9BFF;
}

QPushButton#sendmsg:pressed {
    background-color: #3B7AE8;
    border-color: #3B7AE8;
}

QPushButton#sendmsg:disabled {
    background-color: #161A21;
    border-color: #1E2530;
    color: #4E5666;
}

/* ---------- 通用文本 ---------- */

QLabel {
    color: #98A2B3;
}

/* ---------- 无边框窗口标题栏按钮 ---------- */

QPushButton#framelessCloseBtn,
QPushButton#framelessMaxBtn {
    background-color: transparent;
    border: none;
    color: #6A7383;
    font-size: 15px;
    font-weight: 500;
    padding: 0;
    border-radius: 6px;
}

QPushButton#framelessCloseBtn:hover {
    background-color: #E5484D;
    color: #FFFFFF;
}

QPushButton#framelessMaxBtn:hover {
    background-color: #212836;
    color: #E9EDF4;
}
/* ---------- 顶栏「会议设置」按钮 ---------- */

QPushButton#btnMeetingSettings {
    background-color: #161A21;
    border: 1px solid #1E2530;
    border-radius: 999px;
    color: #98A2B3;
    font-size: 12px;
    padding: 2px 12px;
}

QPushButton#btnMeetingSettings:hover {
    background-color: #1B2029;
    border-color: #2E3846;
    color: #E9EDF4;
}

QPushButton#btnMeetingSettings:pressed {
    background-color: #12161D;
    border-color: #4C8DFF;
}
