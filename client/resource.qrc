<RCC>
    <!--
        资源约定（详见 resources/README.md）：
          图片  → resources/images/     :/ui/images/<名字>
          音频  → resources/audio/      :/ui/audio/<名字>
          字体  → resources/fonts/      :/ui/fonts/<名字>
        代码里统一用 :/ui/... 访问，禁止相对路径。

        历史遗留的 /myImage、/myEffect 前缀已移除；
        原先引用它们的两处代码（configure.h、chat_controller.cpp）已改到新路径，
        其中 chat_controller 原来用的是 qrc:/myEffect/2.wav（少了一层 source/，
        实际一直加载失败），本次一并修正。
    -->
    <qresource prefix="/ui/images">
        <file alias="demo-avatar.png">resources/images/demo-avatar.png</file>
        <file alias="loading.gif">resources/images/loading.gif</file>
    </qresource>

    <qresource prefix="/ui/icons">
        <file alias="calendar.svg">resources/icons/calendar.svg</file>
        <file alias="camera-off.svg">resources/icons/camera-off.svg</file>
        <file alias="camera.svg">resources/icons/camera.svg</file>
        <file alias="hangup.svg">resources/icons/hangup.svg</file>
        <file alias="mic-off.svg">resources/icons/mic-off.svg</file>
        <file alias="mic.svg">resources/icons/mic.svg</file>
        <file alias="record.svg">resources/icons/record.svg</file>
        <file alias="screen-share.svg">resources/icons/screen-share.svg</file>
        <file alias="send.svg">resources/icons/send.svg</file>
        <file alias="settings.svg">resources/icons/settings.svg</file>
        <file alias="user.svg">resources/icons/user.svg</file>
        <file alias="users.svg">resources/icons/users.svg</file>
        <file alias="video.svg">resources/icons/video.svg</file>
        <file alias="panel.svg">resources/icons/panel.svg</file>
        <file alias="info.svg">resources/icons/info.svg</file>
        <file alias="chat.svg">resources/icons/chat.svg</file>
        <file alias="chevron-down.svg">resources/icons/chevron-down.svg</file>
    </qresource>

    <qresource prefix="/ui/audio">
        <file alias="message.wav">resources/audio/message.wav</file>
    </qresource>

    <!--
        QSS 放在 src/ui/theme/（属于"代码性资源"，需要随代码一起评审）。
        用 alias 保留 :/Style/source/xxx.qss 旧路径，调用点零改动。
    -->
    <qresource prefix="/Style">
        <file alias="source/style.qss">src/ui/theme/style.qss</file>
        <file alias="source/login.qss">src/ui/theme/login.qss</file>
        <file alias="source/main_window.qss">src/ui/theme/main_window.qss</file>
        <file alias="source/meeting_widget.qss">src/ui/theme/meeting_widget.qss</file>
        <file alias="source/meeting_settings_popup.qss">src/ui/theme/meeting_settings_popup.qss</file>
        <file alias="source/stack_recordings.qss">src/ui/theme/stack_recordings.qss</file>
        <file alias="source/recording_playback_dialog.qss">src/ui/theme/recording_playback_dialog.qss</file>
        <file alias="source/edit_profile_dialog.qss">src/ui/theme/edit_profile_dialog.qss</file>
        <file alias="source/avatar_crop_dialog.qss">src/ui/theme/avatar_crop_dialog.qss</file>
    </qresource>

    <!--
        内置默认配置：磁盘上 <exe>/config/client.json 优先，
        不存在时回退到这里的 .default（加载日志会打印实际来源）。
    -->
    <qresource prefix="/config">
        <file alias="client.json.default">config/client.json</file>
    </qresource>
</RCC>
