root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.py]
indent_size = 4

[*.pro]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

# deploy.ps1 必须带 UTF-8 BOM：Windows PowerShell 5.1 解析中文注释时需要
[*.ps1]
end_of_line = crlf
charset = utf-8-bom
