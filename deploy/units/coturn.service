[Unit]
Description=coturn TURN/STUN server (3478/5349)
After=network.target

[Service]
Type=simple
# 注意：不要加 -o（daemonize），否则 systemd 会认为进程退出并循环重启
ExecStart=/usr/local/bin/turnserver -c /usr/local/etc/turnserver.conf
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
