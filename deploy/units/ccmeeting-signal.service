[Unit]
Description=CloudMeeting signaling server (loopback 127.0.0.1:8889, public 8888 via nginx stream)
After=network.target

[Service]
Type=simple
# 二进制不读取相对路径文件（配置全部来自环境变量），因此不设置 WorkingDirectory，
# 避免依赖未纳入部署脚本的构建目录；ExecStart 路径见部署说明。
ExecStart=/root/code/build/server-wss/message_server/CloudMeetingServer
Restart=always
RestartSec=2
LimitNOFILE=65535
    # nginx stream 在 8888 终止 TLS，后端只监听本机
    Environment=CCMEETING_SIGNAL_BIND=127.0.0.1
    Environment=CCMEETING_SIGNAL_PORT=8889
    # 生产：创建/加入会议必须带 auth 服务签发的 token
    EnvironmentFile=/etc/ccmeeting-auth.env
    Environment=CCMEETING_REQUIRE_AUTH=1

[Install]
WantedBy=multi-user.target
