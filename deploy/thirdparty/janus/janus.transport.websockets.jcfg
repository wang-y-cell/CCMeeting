# Janus WebSockets 传输配置模板
#
# 部署时覆盖到：
#   /opt/janus/etc/janus/janus.transport.websockets.jcfg
#
# 客户端 client.json 的 janus_ws_url 对应 ws_port（wss 对应 wss_port）。

general: {
	json = "compact"
	ws_port = 8188
	ws_interface = "0.0.0.0"
	wss_port = 8989
	# 证书（与 443/8888 共用同一张自签证书，见 docs/deploy/TLS.md 第 9 节）
	cert_pem = "/etc/ccmeeting/tls/cert.pem"
	key_pem = "/etc/ccmeeting/tls/key.pem"
	# 管理接口保持关闭
	admin_ws = false
	admin_ws_port = 7188
	admin_wss = false
}
