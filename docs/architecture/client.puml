@startuml client
title CCMeeting 客户端 (client) 类图

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false

' ========== 配置与会话 ==========
package "configure" {
  class ClientConfig {
    {static} +instance() : ClientConfig&
    +load() : bool
    +auth() : AuthConfigData&
    +meeting_server() : MeetingServerConfig&
    +webrtc() : WebRtcConfig&
    -auth_ : AuthConfigData
    -meeting_server_ : MeetingServerConfig
    -webrtc_ : WebRtcConfig
  }

  class AuthConfigData <<struct>> {
    +host : QString
    +port : int
    +login_path : QString
  }

  class MeetingServerConfig <<struct>> {
    +host : QString
    +port : int
  }

  class WebRtcConfig <<struct>> {
    +janus_ws_url : QString
    +admin_key : QString
    +video : WebRtcVideoConfig
    +ice_servers : vector<IceServerConfig>
  }

  class UserSession {
    {static} +instance() : UserSession&
    +isLoggedIn() : bool
    +userId() : qint64
    +name() : QString
    +setUser(...) : void
    +clear() : void
  }
}

' ========== UI 层 ==========
package "widget" {
  class FramelessWindow<T> <<template>> {
    .. 无边框窗口基类 ..
  }

  class login {
    -m_nam : QNetworkAccessManager
    +Login() : void
    -onLoginFinished(reply) : void
  }

  class main_window {
    -widget : MeetingWidget*
    -create_meeting_widget : stack_create_meet*
    -join_meeting_widget : stack_join_meet*
  }

  class MeetingWidget {
    -_network : shared_ptr<NetworkManager>
    -_controller : unique_ptr<MeetingController>
    -_cameraVideo : CameraVideo*
    -_rtc : IXRtcEngine*
    +start_meeting_media() : void
    +stop_meeting_media() : void
    -build_join_config() : XRTCJoinConfig
    .. XRtcEngineObserver 回调 ..
  }

  class MeetingController {
    -_network : shared_ptr<NetworkManager>
    +connect_to_server_slot(...) : void
    +create_meeting_slot(...) : void
    +join_meeting_slot(room_no) : void
  }

  class Partner {
    +ip() : uint32_t
    +setProfile(...) : void
    +setTile(tile) : void
  }

  enum ConnectAction {
    None
    CreateMeeting
    JoinMeeting
  }
}

' ========== 网络层 ==========
package "messageNet" {
  class NetworkManager {
    -hub_ : MessageHub*
    -connection_ : Connection*
    +connect_to_server(ip, port) : bool
    +send_create_meeting(...) : void
    +send_join_meeting(room_no) : void
    +send_text(text) : void
    +send_close_camera() : void
    +send_user_profile(...) : void
    --
    request_message_ready
    user_info_message_ready
    text_message_ready
  }

  class MessageHub {
    -send_queue_ : PriorityMessageQueue
    -connection_ : Connection*
    +enqueue_send(msg) : void
    +route_incoming(msg) : void
    +start_send_worker() : void
    --
    request_message_ready
    text_message_ready
  }

  class Connection {
    -m_hub : MessageHub*
    -m_socket : QTcpSocket*
    -m_parser : WireStreamParser
    +connectToServer(ip, port) : bool
    +sendWireData(frame) : bool
    +localIp() : uint32_t
  }

  class MessageCodec {
    {static} +encode_wire_frame(msg, local_ip) : QByteArray
    {static} +decode_wire_packet(...) : MessagePtr
    +WireStreamParser
  }

  class MessageCodec.WireStreamParser {
    -buffer_ : QByteArray
    +feed(data, len) : vector<MessagePtr>
    +reset() : void
  }

  class PriorityMessageQueue {
    +push(msg) : void
    +pop(wait_ms) : optional<MessagePtr>
  }

  abstract class Message {
    +kind() : MessageKind
    +send_priority() : MessagePriority
    +ip() : uint32_t
  }

  class CreateMeetingMessage
  class JoinMeetingMessage
  class SendTextMessage
  class CloseCameraMessage
  class SendUserProfileMessage
  class CreateMeetingResponseMessage
  class JoinMeetingResponseMessage
  class RecvTextMessage
  class PartnerJoinMessage
  class PartnerExitMessage
  class PartnerJoin2Message
  class CloseCameraNotifyMessage
  class UserProfileNotifyMessage
}

' ========== 显示层 ==========
package "message.video" {
  class CameraVideo {
    -_mainVideoImg : ImgDisplay*
    -_partnerDisplays : map<uint32_t, ImgDisplay*>
    +showImageForIp(ip, image) : void
    +showMainImage(image) : void
  }

  class ImgDisplay {
    +showImage(image) : void
    +setTarget(widget) : void
    enum DrawMode
  }
}

' ========== xrtc SDK（外部） ==========
package "xrtc <<SDK>>" #LightBlue {
  interface IXRtcEngine {
    +join(config) : void
    +leave() : void
    +mute_audio(mute) : void
    +mute_video(mute) : void
    +get_video_device_info() : vector<XRTCDeviceInfo>
  }

  class XRtcEngineObserver {
    +on_video_frame(...) : void
    +on_remote_video_frame(...) : void
    +on_join_result(...) : void
    +on_remote_user_joined(...) : void
    ..
  }

  class XRTCJoinConfig <<struct>> {
    +janus_ws_url : string
    +room_id : uint64_t
    +display_name : string
    +ice_servers : vector<XRTCIceServer>
  }

  class XRTCVideoFrame <<struct>> {
    +width / height : int
    +argb : shared_ptr<vector<uint8_t>>
  }
}

' ========== 继承 ==========
FramelessWindow <|-- login
FramelessWindow <|-- main_window
FramelessWindow <|-- MeetingWidget
XRtcEngineObserver <|.. MeetingWidget

Message <|-- CreateMeetingMessage
Message <|-- JoinMeetingMessage
Message <|-- SendTextMessage
Message <|-- CloseCameraMessage
Message <|-- SendUserProfileMessage
Message <|-- CreateMeetingResponseMessage
Message <|-- JoinMeetingResponseMessage
Message <|-- RecvTextMessage
Message <|-- PartnerJoinMessage
Message <|-- PartnerExitMessage
Message <|-- PartnerJoin2Message
Message <|-- CloseCameraNotifyMessage
Message <|-- UserProfileNotifyMessage

' ========== 组合 / 依赖 ==========
main_window *-- MeetingWidget
MeetingWidget *-- NetworkManager
MeetingWidget *-- MeetingController
MeetingWidget *-- CameraVideo
MeetingWidget --> IXRtcEngine : _rtc
MeetingWidget ..> ClientConfig : build_join_config
MeetingWidget ..> UserSession
MeetingWidget "1" o-- "0..*" Partner

MeetingController --> NetworkManager
NetworkManager *-- MessageHub
NetworkManager *-- Connection
Connection --> MessageHub : route_incoming
Connection *-- MessageCodec.WireStreamParser
MessageHub *-- PriorityMessageQueue
MessageCodec ..> Message

CameraVideo *-- ImgDisplay

login ..> ClientConfig : HTTP 登录
login ..> UserSession : setUser

ClientConfig *-- AuthConfigData
ClientConfig *-- MeetingServerConfig
ClientConfig *-- WebRtcConfig

note bottom of MeetingWidget
  TCP：房间/文字/成员控制 → message_server
  WebRTC：音视频 → Janus VideoRoom
end note

note bottom of NetworkManager
  MessageHub 单发送线程 + 优先级队列
  Connection IO 线程 + 流式解帧
end note

@enduml
