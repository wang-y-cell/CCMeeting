@startuml data_server
title CCMeeting 认证服务器 (server2) 类图

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false

' ========== 配置 ==========
package "config" {
  class AuthServerConfig <<struct>> {
    +listen_address : string
    +listen_port : uint16_t
    +mysql_host : string
    +mysql_port : unsigned int
    +mysql_user : string
    +mysql_password : string
    +mysql_database : string
  }
}

' ========== HTTP 层 ==========
package "http_api" {
  class HttpServer {
    -ioc_ : io_context&
    -acceptor_ : tcp::acceptor
    -auth_service_ : shared_ptr<AuthService>
    +HttpServer(ioc, config, auth_service)
    +start() : void
    -do_accept() : void
  }

  class HttpSession {
    -stream_ : beast::tcp_stream
    -buffer_ : flat_buffer
    -request_ : request<string_body>
    -auth_service_ : shared_ptr<AuthService>
    +HttpSession(socket, auth_service)
    +run() : void
    -do_read() : void
    -handle_request(req) : void
    -send_response(res) : void
  }
}

' ========== 业务服务 ==========
package "service" {
  class AuthService {
    -repository_ : UserRepository
    +AuthService(repository)
    +login(username, password, client_ip, device_info) : LoginResult
  }
}

' ========== 仓储层 ==========
package "repository" {
  class UserCredential <<struct>> {
    +user_id : uint64_t
    +username : string
    +password_hash : string
    +status : unsigned int
  }

  class UserRepository {
    -mysql_ : MysqlClient
    +UserRepository(mysql)
    +find_credential_by_username(username) : optional<UserCredential>
    +load_user_info(user_id, fallback_name) : UserInfo
    +insert_login_log(user_id, login_ip, device_info, success) : void
  }
}

' ========== 数据库 ==========
package "db" {
  class MysqlClient {
    -config_ : AuthServerConfig
    +MysqlClient(config)
    +create_connection() : unique_ptr<sql::Connection>
  }
}

' ========== 模型 ==========
package "model" {
  class UserInfo <<struct>> {
    +id : uint64_t
    +name : string
    +avatar : string
    +info : string
  }

  class LoginResult <<struct>> {
    +success : bool
    +code : int
    +message : string
    +user : UserInfo
  }
}

' ========== 工具 ==========
package "util" {
  class password_hasher <<utility>> {
    {static} +sha256_hex(plain) : string
    {static} +verify_password(plain, expected_hash) : bool
  }

  class json_helper <<utility>> {
    .. JSON 解析/序列化辅助 ..
  }
}

' ========== 关系 ==========
HttpServer o-- AuthServerConfig : 监听配置
HttpServer --> AuthService : 共享

HttpSession ..> AuthService : 处理 /api/login
HttpServer ..> HttpSession : accept 创建

AuthService *-- UserRepository
AuthService ..> LoginResult : 返回
AuthService ..> password_hasher : 校验密码

UserRepository *-- MysqlClient
UserRepository ..> UserCredential
UserRepository ..> UserInfo

MysqlClient o-- AuthServerConfig

LoginResult *-- UserInfo

note bottom of HttpSession
  Boost.Beast 异步 HTTP
  POST /api/login → AuthService::login
end note

note bottom of UserRepository
  sys_users / sys_user_profiles
  登录审计日志
end note

@enduml
